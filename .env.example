# Supabase Configuration (Required)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI Configuration (Required for Ash AI Chat & Sketch Generation)
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your-openai-api-key

# Shopify Configuration (Optional - for product integration)
# Domain: your-store.myshopify.com
# Storefront Token: Get from Shopify Admin > Apps > Manage private apps
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token

# Klaviyo Configuration (Optional - for email marketing)
KLAVIYO_PRIVATE_KEY=your_klaviyo_private_key
KLAVIYO_LIST_ID=your_klaviyo_list_id

# Gemini API (Alternative AI - Optional)
GEMINI_API_KEY=your_gemini_api_key
